{
  "name": "openfortivpn-manager",
  "version": "0.1.6",
  "packageManager": "pnpm@10.24.0",
  "description": "Cross-platform profile and process manager for openfortivpn",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "engine:build": "node scripts/build-engine.mjs",
    "desktop:dev": "npm run engine:build && npm run dev",
    "desktop:build": "npm run engine:build && npm run build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node ../web/build.mjs --check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-or-later",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": { "cookie": "0.7.2" }
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.0",
    "@tauri-apps/plugin-opener": "~2.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.6.3",
    "vite": "^6.4.4"
  }
}
